# Copy this file to .env and fill in as needed. Everything here has a sane
# default for solo/local use, so an empty .env (or none at all) also works.

# SQLite is the default; leave unset to use ./data/dipsip.db
# DATABASE_URL=sqlite:///./data/dipsip.db

# Set this to require an `X-API-Key` header on every request — recommended
# once this is deployed anywhere reachable from the open internet.
# Leave unset for local-only / personal use with no auth.
# API_KEY=change-me

# When the daily NAV refresh + alert job runs (24h clock, in TIMEZONE below).
# AMFI usually publishes the day's NAVs by early evening IST.
SCHEDULER_HOUR=18
SCHEDULER_MINUTE=30
TIMEZONE=Asia/Kolkata

# Optional: push alerts to Telegram. Leave both blank to disable — alerts
# still get logged and are readable via GET /alerts either way.
# Create a bot via @BotFather to get a token, and message the bot once,
# then hit https://api.telegram.org/bot<token>/getUpdates to find your chat id.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
